# Hyperliquid testnet credentials. Fund the account manually with testnet USDC.
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_TESTNET=true

# Supabase service role credentials.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Alerts.
DISCORD_WEBHOOK_URL=
SMS_ALERTS_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555555555
TWILIO_TO_NUMBER=+15555555555

# Risk limits. Percent values are whole percentages here.
MAX_DAILY_LOSS_PCT=5.0
MAX_WEEKLY_LOSS_PCT=10.0
MAX_DRAWDOWN_PCT=20.0

# Strategy/runtime toggles.
STRATEGIES_ENABLED=cme_gap_fill,rsi_mean_reversion
STARTING_BALANCE_USD=1000
CLOSE_POSITIONS_ON_SHUTDOWN=false

# Deployment.
DROPLET_HOST=
DROPLET_USER=levatetrader
DROPLET_APP_DIR=/opt/levate-trader
