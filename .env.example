# Execution mode:
# - paper_sim: read Hyperliquid mainnet public market data and simulate fills locally.
# - testnet_real: place real orders on Hyperliquid testnet.
# - mainnet_real: refused in v1.
EXECUTION_MODE=paper_sim
ACCOUNT_ID=balanced
PERSONALITY=balanced

# Hyperliquid credentials. Optional if EXECUTION_MODE=paper_sim.
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_TESTNET=true

# Supabase service role credentials.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Alerts.
DISCORD_WEBHOOK_URL=
SMS_ALERTS_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555555555
TWILIO_TO_NUMBER=+15555555555

# Risk limits. Percent values are whole percentages here.
MAX_DAILY_LOSS_PCT=5.0
MAX_WEEKLY_LOSS_PCT=10.0
MAX_DRAWDOWN_PCT=20.0
MAX_POSITION_SIZE_PCT=10.0
LEVERAGE_CAP=15

# Strategy/runtime toggles.
STRATEGIES_ENABLED=micro_rsi_scalp,book_imbalance,volume_fade,rsi_mean_reversion,cme_gap_fill
STARTING_BALANCE_USD=1000
PAPER_SLIPPAGE_BPS=5
PAPER_MAX_PENDING_ORDERS=10
SCALP_MODE_ENABLED=true
SCALP_MAX_HOLD_MINUTES=15
SCALP_COOLDOWN_SECONDS=600
CHAOS_MODE=false
MARKET_DATA_WRITER=true
CLOSE_POSITIONS_ON_SHUTDOWN=false

# Deployment.
DROPLET_HOST=
DROPLET_USER=levatetrader
DROPLET_APP_DIR=/opt/levate-trader
