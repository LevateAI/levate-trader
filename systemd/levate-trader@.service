[Unit]
Description=Levate Tournament Paper Trader (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=levateai
WorkingDirectory=/home/levateai/levate-trader
EnvironmentFile=/home/levateai/levate-trader/envs/%i.env
Environment=ACCOUNT_ID=%i
ExecStart=/home/levateai/levate-trader/.venv/bin/python -m src.main
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
